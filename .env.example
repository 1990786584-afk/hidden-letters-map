# 复制成 .env 再填。.env 不进 git。

# 必填：页面登录、MCP、定位 App 上报都用这一个密码
PASSWORD=change-me

PORT=3000
# 数据目录（map.json / track.jsonl / last-seen.json / push-subscriptions.json），默认 ./data
# DATA_DIR=./data

# 页面上怎么称呼两个人：藏宝的（落款、「TA 藏的东西」）和寻宝的（成就上一圈 FOR xxx · WITH LOVE）
HIDER_NAME=TA
FINDER_NAME=YOU

# 「来过几天才解锁」按哪个时区算一天；不填按系统时区
# TZ=Asia/Tokyo

# 街景（可选）：Google Maps 的钥匙，开了 Street View Static API 的那种；填了藏东西时会抓一张附近的街景，拆开以后详情页里能看到
# GOOGLE_MAPS_API_KEY=

# 推送（可选）：npx web-push generate-vapid-keys 生成一对填进来；不填就不推送，其他照常
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# ZFxF：可把服务器只监听在 127.0.0.1，再通过 HTTPS 反向代理安全访问
# HOST=127.0.0.1

# 约会邀请 / 回执（默认只保存在 DATA_DIR/date-cards.json）
# 提交后若希望唤醒自己部署的 AI agent，请在这里填写受信任的 HTTPS Webhook
# 未配置时仍能从 iPhone 提交并保存、通过 MCP 读取，**不会自动通知 ChatGPT**
# DATE_CARD_WEBHOOK_URL=https://your-trusted-agent.example/hooks/date-card
# DATE_CARD_WEBHOOK_TOKEN=server-side-secret
